# ============================================================
# CampusHub 环境变量示例
# ============================================================
# 复制为 .env 并按实际环境填写。生产环境必须覆盖所有带"必填"标记的变量。
# local/dev 环境可使用 application.properties 中的默认值，无需配置全部变量。

# ---------- Spring profile ----------
# 激活 prod profile 会启用 application-prod.properties（敏感配置无默认值）
SPRING_PROFILES_ACTIVE=local

# ---------- 数据库 ----------
# local 默认 localhost/root/root；生产必须覆盖 DB_URL/DB_USERNAME/DB_PASSWORD
DB_URL=jdbc:mysql://localhost:3306/campushub?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# ---------- JWT ----------
# 生产必填：Base64 编码，解码后 >=32 字节；未配置则 prod profile 启动失败
# 生成示例：openssl rand -base64 48
APP_JWT_SECRET=ZGV2LWNhbXB1c2h1Yi1qd3Qtc2VjcmV0LWtleS1mb3ItZGV2ZWxvcG1lbnQtb25seS0yNTYtYml0cw==
APP_JWT_EXPIRY_SECONDS=3600

# ---------- 邮箱验证码 ----------
APP_AUTH_ALLOWED_EMAIL_DOMAINS=edu.cn,example.edu.cn,nju.edu.cn,smail.nju.edu.cn
APP_MAIL_FROM=noreply@campushub.edu.cn

# ---------- SMTP ----------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROTOCOL=smtp
SPRING_MAIL_DEFAULT_ENCODING=UTF-8
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false
SPRING_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000

# ---------- AI 草稿生成（OpenAI-compatible） ----------
# 未配置 AI_API_KEY 时应用仍能启动，AI 接口返回业务错误
AI_BASE_URL=https://tokenhub.tencentmaas.com
AI_API_KEY=not-configured
AI_MODEL=deepseek/deepseek-flash
AI_CONNECT_TIMEOUT_MS=10s
AI_READ_TIMEOUT_MS=60s
AI_RETRY_MAX_ATTEMPTS=2
AI_DEMAND_DRAFT_PROMPT_MAX_LENGTH=1000
AI_DEMAND_DRAFT_RATE_LIMIT_WINDOW_MS=60000
AI_DEMAND_DRAFT_RATE_LIMIT_MAX_PER_WINDOW=5
AI_DEMAND_DRAFT_RATE_LIMIT_MAX_CONCURRENT=3

# ---------- 演示数据 ----------
# local 默认 false（不创建演示账号）；CI 显式关闭
APP_DEMO_DATA_ENABLED=false
