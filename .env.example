# ============================================================
# CampusHub 环境变量示例
# ============================================================
# 本文件是环境变量清单与取值参考。复制为 .env 后仍需手动注入进程环境：
# Spring Boot 不读取 .env 文件（项目未引入 spring-dotenv，也没有 docker-compose
# 的 env_file），变量不会因为写了这个文件就自动生效。
#
#   bash / zsh / Git Bash：
#     set -a && source .env && set +a && cd backend && ./mvnw spring-boot:run
#
#   PowerShell（-Encoding UTF8 不可省略：本文件含中文注释，用默认编码读取会
#    乱码并吞掉换行符，导致只加载到部分变量）：
#     Get-Content -Encoding UTF8 .env | Where-Object { $_ -match '^\s*[A-Za-z_][A-Za-z0-9_]*=' } | ForEach-Object {
#         $name, $value = $_ -split '=', 2
#         Set-Item "env:$($name.Trim())" $value.Trim().Trim('"')
#     }
#     cd backend; .\mvnw.cmd spring-boot:run
#
#   也可以在 IDE 的 Run Configuration 或 CI 的环境变量面板中直接配置。
#
# 除末尾「生产环境必填」外，所有变量都有默认值，未配置也能正常启动。
# 各项配置的影响见 README「配置方式」一节。

# ---------- Spring profile ----------
# 可选。local（默认）读取 application-local.properties（已 gitignore）；
# prod 读取 application-prod.properties，且必须提供文末「生产环境必填」的全部变量。
# SPRING_PROFILES_ACTIVE="local"

# ---------- 数据库 ----------
# local profile 下数据源 URL 与用户名固定为 localhost:3306/campushub 与 root
# （见 application.properties），仅密码可通过环境变量覆盖；
# 换地址或账号请改用 application-local.properties 或 prod profile。
DB_PASSWORD="your-db-password"

# ---------- JWT ----------
# 生产必填：Base64 编码，解码后 >=32 字节；未配置则 prod profile 启动失败。
# local profile 未配置时使用仅供开发的默认密钥，生产环境绝不可依赖该默认值。
# 生成方式：openssl rand -base64 48
# APP_JWT_SECRET=""
# 令牌有效期（秒）
APP_JWT_EXPIRY_SECONDS="3600"

# ---------- 邮箱验证码 ----------
# 注册邮箱域名白名单，逗号分隔。至少保留一个域名，留空会拒绝所有邮箱注册。
APP_AUTH_ALLOWED_EMAIL_DOMAINS="example.edu.cn,your-university.edu.cn"
# 验证码邮件发件人地址，需与下方 SMTP 账号一致
APP_MAIL_FROM="noreply@example.com"

# ---------- SMTP ----------
# 可选。不配置 SPRING_MAIL_HOST 时，验证码退化为后端控制台日志输出，不阻塞启动。
SPRING_MAIL_HOST=""
SPRING_MAIL_PORT="587"
SPRING_MAIL_USERNAME=""
SPRING_MAIL_PASSWORD=""
SPRING_MAIL_PROTOCOL="smtp"
SPRING_MAIL_DEFAULT_ENCODING="UTF-8"
SPRING_MAIL_SMTP_AUTH="true"
SPRING_MAIL_SMTP_STARTTLS_ENABLE="true"
SPRING_MAIL_SMTP_STARTTLS_REQUIRED="false"
SPRING_MAIL_SMTP_SSL_ENABLE="false"
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT="5000"
SPRING_MAIL_SMTP_TIMEOUT="5000"
SPRING_MAIL_SMTP_WRITE_TIMEOUT="5000"

# ---------- AI 草稿生成（OpenAI-compatible） ----------
# 可选。未配置时应用仍能启动，AI 接口返回明确的业务错误。
# 下面取值为 DeepSeek，其他服务商（Qwen / OpenAI 等）见 README「服务商配置示例」。
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY="sk-your-api-key"
AI_MODEL="deepseek-chat"
AI_CONNECT_TIMEOUT_MS="10s"
AI_READ_TIMEOUT_MS="60s"
AI_RETRY_MAX_ATTEMPTS="2"
AI_DEMAND_DRAFT_PROMPT_MAX_LENGTH="1000"
AI_DEMAND_DRAFT_RATE_LIMIT_WINDOW_MS="60000"
AI_DEMAND_DRAFT_RATE_LIMIT_MAX_PER_WINDOW="5"
AI_DEMAND_DRAFT_RATE_LIMIT_MAX_CONCURRENT="3"

# ---------- 演示数据 ----------
# 设为 true 时启动预置 admin 演示账号；默认 false，不创建
APP_DEMO_DATA_ENABLED="false"

# ============================================================
# 生产环境必填（SPRING_PROFILES_ACTIVE=prod，缺失任一变量都会启动失败）
# ============================================================
# 生产不继承 local 的 localhost/root 默认值，避免静默连错库。
DB_URL="jdbc:mysql:<SECRET_525ae024>"
DB_USERNAME="your-db-username"
# 生成方式见上方 JWT 一节
# APP_JWT_SECRET=""
